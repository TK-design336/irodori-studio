{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Irodori Studio",
  "version": "0.3.2",
  "identifier": "com.irodori.studio",
  "build": {
    "beforeDevCommand": "npm run fetch-ffmpeg && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run fetch-ffmpeg && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Irodori Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../python": "python/",
      "../data/homographs_ndl_seed.json": "data/homographs_ndl_seed.json",
      "../data/counter_words.json": "data/counter_words.json",
      "../vendor/ffmpeg": "ffmpeg/"
    }
  }
}
